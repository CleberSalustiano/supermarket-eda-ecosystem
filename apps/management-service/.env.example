NODE_ENV=development
APP_VERSION=0.1.0
SERVICE_NAME=management-service
PORT=3003
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_NAME=management_service
DATABASE_USER=management_user
DATABASE_PASSWORD=management_password
DATABASE_SSL=false
DATABASE_MIGRATIONS_RUN=true
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=management-service
KAFKA_CONSUMER_GROUP_ID=management-service
# required; generate with: openssl rand -hex 32
MANAGEMENT_INTERNAL_API_TOKENS=
MANAGER_APPROVAL_CODE_MAX_FAILURES=5
MANAGER_APPROVAL_CODE_WINDOW_MINUTES=15
MANAGER_APPROVAL_CODE_LOCKOUT_MINUTES=15
MANAGER_APPROVAL_REGISTER_MAX_FAILURES=10
MANAGER_APPROVAL_REGISTER_WINDOW_MINUTES=15
MANAGER_APPROVAL_REGISTER_LOCKOUT_MINUTES=15
